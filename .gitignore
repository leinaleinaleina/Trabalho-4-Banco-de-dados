# Credenciais e configuracoes particulares de cada computador
.local/
.env
.env.*
!.env.example
*.local.properties
*.local.yml
*.local.yaml
**/perfis.properties
.pgpass
pgpass.conf
pg_service.conf
*.pem
*.key
*.p12
*.pfx
id_rsa
id_ed25519

# IntelliJ, outros editores e arquivos de usuario
.idea/
*.iml
*.ipr
*.iws
.vscode/
.project
.classpath
.settings/
*.swp
*.swo
*~

# Compilacao Java/Maven; as dependencias sao obtidas pelo pom.xml
target/
out/
build/
bin/
*.class
*.jar
*.war
*.ear
!.mvn/wrapper/maven-wrapper.jar

# Dados locais do PostgreSQL e copias de seguranca
pgdata/
postgres-data/
backups/
*.dump
*.backup
*.bak
*.pid
.s.PGSQL.*

# Temporarios, logs e caches
tmp/
temp/
.cache/
__pycache__/
*.py[cod]
*.log

# Arquivos gerados pelo sistema operacional
.DS_Store
Thumbs.db
Desktop.ini

# Configuracoes portaveis de execucao devem acompanhar o projeto
!.run/
!.run/*.run.xml

# Devem ser versionados: src/, sql/, docs/, tools/, pom.xml,
# conexao.properties (sem senhas), .run/ e output/pdf/Trabalho_T4.pdf.
